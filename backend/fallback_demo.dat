  "paper_metadata": [
    {
      "document_id": "d0000001-0000-0000-0000-000000000001",
      "title": "GPT-4 for Automated Clinical Note Generation: A Controlled Trial",
      "authors": [
        "Sarah Chen",
        "Marcus Aurelius Vance",
        "Priya Nair",
        "Robert E. Taylor"
      ],
      "publication_year": 2024,
      "venue": "Journal of Medical Internet Research (JMIR)",
      "doi": "10.2196/48201",
      "abstract": "Physician burnout is driven in large part by documentation burden. We conducted a randomized controlled evaluation of GPT-4 assisted SOAP note drafting across 1,200 outpatient patient-clinician encounters. Clinicians using LLM-assisted drafting spent 48% less time documenting per encounter (mean difference 4.2 min, p < 0.001) while maintaining equivalent clinical completeness scores (4.6 vs 4.7/5.0). However, critical error review required continuous vigilance.",
      "target_problems": [
        "Physician documentation burnout",
        "EHR data entry inefficiency",
        "Clinical note transcription latency"
      ],
      "methodology": "Randomized controlled trial with blinded expert clinician review across ambulatory care clinics",
      "key_findings": [
        "48% reduction in physician documentation time",
        "No statistically significant drop in clinical note accuracy",
        "4.2% hallucination rate requiring physician override"
      ],
      "limitations": "Single hospital system; non-specialty visits only; lack of long-term patient outcome tracking",
      "keywords": [
        "GPT-4",
        "Clinical Documentation",
        "SOAP Notes",
        "EHR Integration",
        "Physician Burnout"
      ]
    },
    {
      "document_id": "d0000002-0000-0000-0000-000000000002",
      "title": "Med-PaLM 2: Towards Clinician-Level Medical Question Answering",
      "authors": [
        "Karan Singhal",
        "Tao Tu",
        "Juraj Gottweis",
        "Rory Sayres",
        "Vivek Natarajan"
      ],
      "publication_year": 2023,
      "venue": "Nature Medicine",
      "doi": "10.1038/s41591-023-02422-5",
      "abstract": "We present Med-PaLM 2, an expert-tuned LLM demonstrating clinician-level performance on medical question answering benchmarks. Evaluated on MedQA (USMLE style questions), Med-PaLM 2 achieved 86.5% accuracy, surpassing the previous state of the art by over 18%. Clinical evaluation by a panel of physicians found that Med-PaLM 2 answers reflected clinical consensus in 92.9% of cases.",
      "target_problems": [
        "Medical reasoning accuracy",
        "Clinician-level diagnostic QA",
        "Reliable scientific answer synthesis"
      ],
      "methodology": "Domain-specific instruction fine-tuning and ensemble refinement on top of PaLM-2 architecture",
      "key_findings": [
        "86.5% score on USMLE-style MedQA questions",
        "92.9% alignment with physician consensus panel",
        "Demonstrates multi-step diagnostic reasoning"
      ],
      "limitations": "Potential overconfidence on edge-case rare diseases; evaluation limited to text benchmarks rather than live interactive bedside scenarios",
      "keywords": [
        "Med-PaLM 2",
        "Medical QA",
        "USMLE",
        "Clinical Reasoning",
        "Instruction Tuning"
      ]
    },
    {
      "document_id": "d0000003-0000-0000-0000-000000000003",
      "title": "BioGPT: Generative Pre-trained Transformer for Biomedical Text Generation and Mining",
      "authors": [
        "Renqian Luo",
        "Lixin Sun",
        "Yingce Xia",
        "Tao Qin",
        "Sheng Zhang",
        "Tie-Yan Liu"
      ],
      "publication_year": 2023,
      "venue": "Briefings in Bioinformatics",
      "doi": "10.1093/bib/bbac409",
      "abstract": "Pre-trained language models have become foundational tools in biomedicine. We develop BioGPT, a generative language model trained on 15 million PubMed abstracts. BioGPT achieves state-of-the-art results on BC5CDR, KD-DTI, and PubMedQA benchmarks, outperforming prior models such as BioBERT and PubMedBERT on extraction and question-answering tasks.",
      "target_problems": [
        "Biomedical relation extraction",
        "PubMed text mining",
        "Domain-specialized scientific generation"
      ],
      "methodology": "Autoregressive GPT architecture pre-trained from scratch on domain-specific biomedical literature",
      "key_findings": [
        "Outperforms PubMedBERT on biomedical relation extraction",
        "81.0% accuracy on PubMedQA biomedical benchmark",
        "High fidelity extraction of drug-disease interactions"
      ],
      "limitations": "Smaller model capacity (347M parameters) compared to modern frontier LLMs; restricted to PubMed vocabulary",
      "keywords": [
        "BioGPT",
        "Biomedical Text Mining",
        "Relation Extraction",
        "PubMedQA",
        "PubMed Pre-training"
      ]
    },
    {
      "document_id": "d0000004-0000-0000-0000-000000000004",
      "title": "Hallucination in Large Language Models for Healthcare: A Systematic Survey",
      "authors": [
        "Elena Rostova",
        "Alok Kumar",
        "David M. Sterling",
        "Mei-Ling Zhou"
      ],
      "publication_year": 2024,
      "venue": "The Lancet Digital Health",
      "doi": "10.1016/S2589-7500(24)00088-2",
      "abstract": "Hallucinations in medical LLMs pose severe risks to patient safety. In this systematic survey, we analyze 78 clinical LLM deployment studies and classify hallucinations into factual divergence, fabricated citations, contraindicated drug recommendations, and diagnostic overconfidence. We evaluate mitigation strategies including retrieval-augmented generation (RAG), self-consistency sampling, and constrained decoding.",
      "target_problems": [
        "Medical hallucination taxonomy",
        "Clinical safety risk assessment",
        "Evaluation of anti-hallucination guardrails"
      ],
      "methodology": "Systematic literature survey and meta-analysis of 78 peer-reviewed clinical LLM studies",
      "key_findings": [
        "RAG reduces factual hallucination rates from 14.2% down to 2.8%",
        "Fabricated medical citations occur in 18% of zero-shot outputs",
        "No benchmark reliably captures safety risks in pediatric or rare-disease dosing"
      ],
      "limitations": "Heterogeneous definitions of hallucination across survey papers; rapidly evolving proprietary model updates",
      "keywords": [
        "Hallucination",
        "Patient Safety",
        "Retrieval-Augmented Generation",
        "Clinical Guardrails",
        "Survey"
      ]
    },
    {
      "document_id": "d0000005-0000-0000-0000-000000000005",
      "title": "Improving Patient-Doctor Communication with Empathetic Large Language Models",
      "authors": [
        "Jessica Morales",
        "Tariq Mansour",
        "Katherine Wu",
        "Aaron J. Klein"
      ],
      "publication_year": 2024,
      "venue": "JAMA Network Open",
      "doi": "10.1001/jamanetworkopen.2024.11294",
      "abstract": "Patient portal messaging volume has tripled post-pandemic. We evaluated LLM-drafted responses to 500 patient inquiries across 5 medical specialties. In a double-blind panel evaluation by healthcare professionals and patient advocates, LLM responses were rated significantly higher for empathy (mean 4.1 vs 3.2 on 5-point Likert, p < 0.001) and clarity (4.4 vs 3.8, p < 0.001) compared to physician-drafted replies.",
      "target_problems": [
        "EHR patient inbox deluge",
        "Empathic patient messaging",
        "Communication clarity and medical literacy barrier"
      ],
      "methodology": "Double-blind comparative evaluation of 500 real-world patient inbox messages with dual clinician/patient panels",
      "key_findings": [
        "LLM responses rated significantly higher on empathy and readability",
        "3.6x longer explanations providing thorough self-care guidance",
        "Physician review time was 62% shorter than drafting from scratch"
      ],
      "limitations": "Subjective ratings; does not assess downstream behavioral compliance or physiological outcomes",
      "keywords": [
        "Patient Communication",
        "Empathy",
        "EHR Portal",
        "Health Literacy",
        "Clinical NLP"
      ]
    },
    {
      "document_id": "d0000006-0000-0000-0000-000000000006",
      "title": "Differential Privacy in Federated Learning: Convergence Bounds and Empirical Tradeoffs",
      "authors": [
        "Alexander Wei",
        "Chao Shen",
        "Hannah Lindqvist"
      ],
      "publication_year": 2023,
      "venue": "IEEE Transactions on Information Forensics and Security",
      "doi": "10.1109/TIFS.2023.3241098",
      "abstract": "Federated learning alone does not prevent reconstruction attacks from client gradient updates. We analyze user-level differential privacy (DP-FedAvg) and establish tight convergence bounds under non-IID client distributions with clipping and Gaussian noise perturbation.",
      "target_problems": [
        "Gradient inversion attacks",
        "Privacy budget vs model utility trade-off",
        "Non-IID convergence degradation"
      ],
      "methodology": "Theoretical proof of convergence under DP perturbation combined with cross-silo healthcare simulations",
      "key_findings": [
        "Identifies optimal clipping thresholds balancing gradient bias and noise variance",
        "Achieves epsilon=3.2 privacy guarantee with less than 2.4% AUC drop on multi-center imaging"
      ],
      "limitations": "Assumes honest-but-curious central aggregator; compute overhead on low-resource edge nodes",
      "keywords": [
        "Federated Learning",
        "Differential Privacy",
        "Convergence Bounds",
        "Gradient Inversion",
        "Healthcare FL"
      ]
    },
    {
      "document_id": "d0000007-0000-0000-0000-000000000007",
      "title": "Robust and Secure Aggregation for Cross-Silo Federated Learning Under Byzantine Faults",
      "authors": [
        "Kenji Takahashi",
        "Dmitri Volkov",
        "Sarah O'Connor"
      ],
      "publication_year": 2024,
      "venue": "ACM Conference on Computer and Communications Security (CCS)",
      "doi": "10.1145/3658644.3658702",
      "abstract": "Cross-silo federated learning in healthcare requires both cryptographic confidentiality and robustness against adversarial data poisoning. We present SecByz, an aggregation protocol combining threshold homomorphic encryption with geometric median gradient filtering.",
      "target_problems": [
        "Byzantine client poisoning",
        "Cryptographic privacy preservation",
        "Cross-silo collusion resistance"
      ],
      "methodology": "Cryptographic protocol design integrating Paillier homomorphic encryption with coordinate-wise trimmed median",
      "key_findings": [
        "Tolerates up to 33% adversarial Byzantine clients without test accuracy degradation",
        "Cryptographic overhead reduced by 4.2x using batch ciphertext packing"
      ],
      "limitations": "Bandwidth overhead remains high for very large transformer weights; relies on threshold trust setup",
      "keywords": [
        "Secure Aggregation",
        "Byzantine Robustness",
        "Homomorphic Encryption",
        "Cross-Silo",
        "Federated Learning"
      ]
    }
  ],
