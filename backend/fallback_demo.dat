          "title": "Med-PaLM 2: Towards Clinician-Level Medical Question Answering",
          "status": "indexed",
          "page_count": 24,
          "chunk_count": 118
        },
        {
          "id": "d0000003-0000-0000-0000-000000000003",
          "filename": "biogpt_biomedical_nlp_2023.pdf",
          "title": "BioGPT: Generative Pre-trained Transformer for Biomedical Text Generation and Mining",
          "status": "indexed",
          "page_count": 16,
          "chunk_count": 82
        }
      ],
      "dimensions": [
        {
          "dimension": "Research Problem",
          "values": {
            "d0000001-0000-0000-0000-000000000001": "Physician burnout driven by manual SOAP documentation in outpatient EHR workflows.",
            "d0000002-0000-0000-0000-000000000002": "Inability of general-purpose LLMs to achieve clinician-level multi-step diagnostic reasoning.",
            "d0000003-0000-0000-0000-000000000003": "Biomedical text mining and relation extraction hindered by lack of domain-native generative models."
          }
        },
        {
          "dimension": "Methodology",
          "values": {
            "d0000001-0000-0000-0000-000000000001": "Randomized controlled trial of 1,200 clinic encounters with blinded expert quality scoring.",
            "d0000002-0000-0000-0000-000000000002": "Medical domain instruction tuning, clinical chain-of-thought, and ensemble consensus voting.",
            "d0000003-0000-0000-0000-000000000003": "Autoregressive generative Transformer trained from scratch on 15M PubMed abstracts."
          }
        },
        {
          "dimension": "Model / Architecture",
          "values": {
            "d0000001-0000-0000-0000-000000000001": "GPT-4 (OpenAI) with structured SOAP note prompt engineering.",
            "d0000002-0000-0000-0000-000000000002": "Med-PaLM 2 (PaLM-2 540B backbone fine-tuned for medical reasoning).",
            "d0000003-0000-0000-0000-000000000003": "BioGPT (347M parameters) based on standard Transformer decoder architecture."
          }
        },
        {
          "dimension": "Dataset",
          "values": {
            "d0000001-0000-0000-0000-000000000001": "1,200 real-world outpatient ambulatory encounters across 4 specialties.",
            "d0000002-0000-0000-0000-000000000002": "MedQA (USMLE questions), MedMCQA, PubMedQA, and MMLU Clinical Medical.",
            "d0000003-0000-0000-0000-000000000003": "15M PubMed abstracts; PubMedQA, BC5CDR, and KD-DTI benchmarks."
          }
        },
        {
          "dimension": "Evaluation Metrics",
          "values": {
            "d0000001-0000-0000-0000-000000000001": "Documentation time (minutes), completeness score (1-5), hallucination rate (%).",
            "d0000002-0000-0000-0000-000000000002": "Multiple choice accuracy (%), clinical consensus alignment (%), expert physician review.",
            "d0000003-0000-0000-0000-000000000003": "Accuracy (%), Micro-F1 score for relation extraction, and perplexity."
          }
        },
        {
          "dimension": "Key Results",
          "values": {
            "d0000001-0000-0000-0000-000000000001": "48% reduction in note completion time; 4.6/5.0 completeness score; 4.2% hallucination rate.",
            "d0000002-0000-0000-0000-000000000002": "86.5% accuracy on USMLE MedQA (+18% over prior SOTA); 92.9% clinical consensus alignment.",
            "d0000003-0000-0000-0000-000000000003": "81.0% accuracy on PubMedQA; state-of-the-art relation extraction on BC5CDR."
          }
        },
        {
          "dimension": "Contributions",
          "values": {
            "d0000001-0000-0000-0000-000000000001": "First large-scale clinical RCT verifying LLM time savings without sacrificing completeness.",
            "d0000002-0000-0000-0000-000000000002": "Established first proof of clinician-level performance on standardized medical licensing exams.",
            "d0000003-0000-0000-0000-000000000003": "Open, specialized generative foundation model tailored specifically for biomedical NLP tasks."
          }
        },
        {
          "dimension": "Limitations",
          "values": {
            "d0000001-0000-0000-0000-000000000001": "Requires physician co-pilot vigilance; non-pediatric ambulatory care only.",
            "d0000002-0000-0000-0000-000000000002": "Closed weights; focused on standardized tests rather than interactive clinical practice.",
            "d0000003-0000-0000-0000-000000000003": "Restricted 1,024-token context window; constrained to PubMed scientific vocabulary."
          }
        }
      ],
      "sources": [
        {
